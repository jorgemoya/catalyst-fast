{
  "name": "catalyst-fast",
  "description": "A cacheable, guest-first BigCommerce storefront on Next.js Cache Components.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "generate": "dotenv -e .env.local -- node ./scripts/generate.cjs",
    "build-config": "dotenv -e .env.local -- tsx ./scripts/build-config.ts",
    "predev": "npm run build-config",
    "dev": "dotenv -e .env.local -- next dev",
    "prebuild": "npm run build-config",
    "build": "dotenv -e .env.local -- next build",
    "start": "dotenv -e .env.local -- next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cache-audit": "tsx ./scripts/cache-audit.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.1.2",
    "@base-ui/react": "^1.6.0",
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@upstash/redis": "^1.35.0",
    "@vercel/functions": "^2.2.12",
    "clsx": "^2.1.1",
    "content-security-policy-builder": "^2.3.0",
    "gql.tada": "^1.8.10",
    "lru-cache": "^11.1.0",
    "next": "16.3.4",
    "next-intl": "^4.6.1",
    "react": "19.1.7",
    "react-dom": "19.1.7",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "std-env": "^3.9.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.12.16",
    "@eslint/eslintrc": "^3.3.1",
    "@gql.tada/cli-utils": "^1.6.3",
    "@next/playwright": "^16.3.4",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/sanitize-html": "^2.16.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.4",
    "graphql": "^16.11.0",
    "postcss": "^8.5.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
