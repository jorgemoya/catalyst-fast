{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // Required by lib/kv and lib/cache/handlers/kv.ts, which use explicit `.ts`
    // extensions. Next loads a cache handler outside the normal module graph, so
    // neither the `~` path alias nor extensionless resolution applies there —
    // without the extensions, `CACHE_HANDLER=kv` fails the build outright.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "@0no-co/graphqlsp",
        "trackFieldUsage": false,
        "shouldCheckForColocatedFragments": false,
        "schemas": [
          {
            "name": "bigcommerce",
            "schema": "./bigcommerce.graphql",
            "tadaOutputLocation": "./bigcommerce-graphql.d.ts"
          }
        ]
      }
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./*"
      ]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
