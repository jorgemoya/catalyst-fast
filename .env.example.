# Copy to .env.local and fill in. Parsed and validated by lib/env.ts.
#
# NOTE: this file is named `env.example` rather than `.env.example` because a
# permission rule blocks writing `.env*`. Rename it with:
#   mv env.example .env.example

# ─── BigCommerce ────────────────────────────────────────────────────────────
# The hash in the store control panel URL: https://store-{hash}.mybigcommerce.com
BIGCOMMERCE_STORE_HASH=

# Storefront API JWT. Must be a storefront token, NOT an OAuth access token —
# the client throws InvalidStorefrontTokenError on a 401 if it isn't JWT-shaped,
# because that mistake otherwise surfaces as a confusing generic auth failure.
# POST /stores/{store_hash}/v3/storefront/api-token
# https://developer.bigcommerce.com/docs/rest-authentication/tokens#create-a-token
BIGCOMMERCE_STOREFRONT_TOKEN=

# Selling channel serving this storefront. Channel 1 mirrors the default Stencil
# storefront, which is convenient for local development; create a dedicated
# channel for production.
BIGCOMMERCE_CHANNEL_ID=1

# Optional. Defaults to mybigcommerce.com.
# BIGCOMMERCE_GRAPHQL_API_DOMAIN=

# Optional. Sent as X-BC-Trusted-Proxy-Secret when set.
# BIGCOMMERCE_TRUSTED_PROXY_SECRET=

# Ceiling on simultaneous in-flight requests to the BigCommerce GraphQL API.
# Requests beyond this queue rather than pile onto the origin, and 429s retry
# with jitter. Matters most immediately after a deploy: `use cache: remote`
# entries are keyed by buildId, so every deploy starts with a cold cache and the
# first traffic wave would otherwise arrive at BigCommerce all at once.
BC_MAX_CONCURRENCY=16

# Comma-separated CDN hostnames, for stores fronted by their own CDN. Overrides
# whatever BigCommerce reports. Consumed by scripts/build-config.ts.
# NEXT_PUBLIC_BIGCOMMERCE_CDN_HOSTNAME=

# ─── Caching ────────────────────────────────────────────────────────────────
# Set to `kv` when self-hosting to back `use cache: remote` with the same KV
# infrastructure the proxy uses for route resolution. Leave unset on Vercel —
# the platform supplies both the default and remote handlers, and overriding
# them would be a downgrade.
# CACHE_HANDLER=kv

# Shared KV store for proxy route resolution. Adapter selection is automatic,
# in this order: Vercel Runtime Cache (VERCEL=1) -> Cloudflare KV binding
# (CATALYST_ROUTES_KV) -> Upstash -> in-process memory. The memory fallback is
# NOT shared across instances, so configure a real store for production.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Namespace prefix for KV keys. Defaults to the store hash. Set this if two
# deployments share one KV store and must not collide.
# KV_NAMESPACE=

# ─── Behavior ───────────────────────────────────────────────────────────────
# BigCommerce generates canonical URLs with a trailing slash by default. This
# MUST agree with `trailingSlash` in next.config.ts and with the normalization
# in proxies/with-routes.ts, or redirects will loop.
# TRAILING_SLASH=true

# ─── Logging ────────────────────────────────────────────────────────────────
# Both default on outside production. CLIENT_LOGGER also reports the
# x-bc-graphql-complexity header per request, which is worth watching when
# adding queries — BigCommerce enforces a complexity budget.
# CLIENT_LOGGER=true
# KV_LOGGER=true
